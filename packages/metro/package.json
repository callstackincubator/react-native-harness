      "import": "./dist/babel-plugin.js",
      "default": "./dist/babel-plugin.js"
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5"
  }
